; The callee pops its arguments; readjusting the stack must keep the flag.
declare x86_stdcallcc { i32, i32, i1 } @stdcall_callee(i32, i32) #0

define i32 @stdcall_caller(i32 %x) {
; CHECK-LABEL: stdcall_caller:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    movl %edi, %esi
; CHECK-NEXT:    callq stdcall_callee@PLT
; CHECK-NEXT:    jae .LBB8_1
; CHECK-NEXT:  # %bb.2: # %e
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB8_1: # %ok
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
entry:
  %r = call x86_stdcallcc { i32, i32, i1 } @stdcall_callee(i32 %x, i32 %x) #0
  %f = extractvalue { i32, i32, i1 } %r, 2
  br i1 %f, label %e, label %ok

ok:
  %v = extractvalue { i32, i32, i1 } %r, 0
  ret i32 %v

e:
  ret i32 -1
}

; GlobalISel falls back to SelectionDAG for returns (and calls) with the flag.
; GISEL: unable to translate instruction: ret{{.*}}(in function: callee)

attributes #0 = { "x86-carry-flag-return" }
attributes #1 = { sspstrong "x86-carry-flag-return" }

; Returns merged by SimplifyCFG are duplicated again, so that the flag is a
; constant for each of them (x86-carry-flag-return pass).
define { i64, i64, i1 } @merged(i32 %x) #0 {
; CHECK-LABEL: merged:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    callq callee@PLT
; CHECK-NEXT:    jae .LBB9_2
; CHECK-NEXT:  # %bb.1: # %unwind
; CHECK-NEXT:    stc
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB9_2: # %cont
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    movl $1, %edi
; CHECK-NEXT:    callq use@PLT
; CHECK-NEXT:    clc
; CHECK-NEXT:    popq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
entry:
  %call = tail call { i64, i64, i1 } @callee(i32 %x) #0
  %failed = extractvalue { i64, i64, i1 } %call, 2
  br i1 %failed, label %unwind, label %cont

unwind:
  %e = insertvalue { i64, i64, i1 } %call, i1 true, 2
  br label %common.ret

common.ret:
  %r = phi { i64, i64, i1 } [ %e, %unwind ], [ { i64 poison, i64 poison, i1 false }, %cont ]
  ret { i64, i64, i1 } %r

cont:
  call void @use(i64 1)
  br label %common.ret
}

; The flag is known from the (frozen) branch condition.
define { i64, i64, i1 } @implied(i32 %x) #0 {
; CHECK-LABEL: implied:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    callq callee@PLT
; CHECK-NEXT:    jae .LBB10_1
; CHECK-NEXT:  # %bb.2: # %common.ret.split
; CHECK-NEXT:    stc
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB10_1: # %select.false
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    incq %rax
; CHECK-NEXT:    clc
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
entry:
  %call = tail call { i64, i64, i1 } @callee(i32 %x) #0
  %failed = extractvalue { i64, i64, i1 } %call, 2
  %v = extractvalue { i64, i64, i1 } %call, 0
  %add = add i64 %v, 1
  %ok = insertvalue { i64, i64, i1 } poison, i64 %add, 0
  %frozen = freeze i1 %failed
  br i1 %frozen, label %common.ret, label %select.false

select.false:
  br label %common.ret

common.ret:
  %pn = phi { i64, i64, i1 } [ %call, %entry ], [ %ok, %select.false ]
  %r = insertvalue { i64, i64, i1 } %pn, i1 %failed, 2
  ret { i64, i64, i1 } %r
}
