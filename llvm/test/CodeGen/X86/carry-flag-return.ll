; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
entry:
  %r = call { i64, i64, i1 } @callee(i32 %x) #0
  %f = extractvalue { i64, i64, i1 } %r, 2
