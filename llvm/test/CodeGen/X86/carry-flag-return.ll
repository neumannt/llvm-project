; With "x86-carry-flag-return", a trailing i1 return value is returned in the
; carry flag (used for C++ P0709 'throws' functions).

declare void @use(i64)
declare void @fill(ptr)

; Constant flags become stc/clc right before the return.
define { i64, i64, i1 } @callee(i32 %x) #0 {
; CHECK-LABEL: callee:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    # kill: def $edi killed $edi def $rdi
; CHECK-NEXT:    testl %edi, %edi
; CHECK-NEXT:    js .LBB0_1
; CHECK-NEXT:  # %bb.2: # %ok
; CHECK-NEXT:    incl %edi
; CHECK-NEXT:    clc
; CHECK-NEXT:    movq %rdi, %rax
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB0_1: # %err
; CHECK-NEXT:    movq use@GOTPCREL(%rip), %rax
; CHECK-NEXT:    stc
; CHECK-NEXT:    movl $22, %edx
; CHECK-NEXT:    retq
entry:
  %c = icmp slt i32 %x, 0
  br i1 %c, label %err, label %ok
err:
  ret { i64, i64, i1 } { i64 ptrtoint (ptr @use to i64), i64 22, i1 true }
ok:
  %v = add i32 %x, 1
  %z = zext i32 %v to i64
  %r = insertvalue { i64, i64, i1 } poison, i64 %z, 0
  %r2 = insertvalue { i64, i64, i1 } %r, i1 false, 2
  ret { i64, i64, i1 } %r2
}

